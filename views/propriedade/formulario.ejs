<% const erros = validationErrors(locals.errors); %>
<% const propriedade = locals.propriedade || {}; %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4><%= titulo %></h4>
            <p class="mb-0">&raquo; Preencha os dados da propriedade</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicial</a></li>
            <li class="breadcrumb-item"><a href="/propriedades">Propriedades</a></li>
            <li class="breadcrumb-item active">Formulário</li>
        </ol>
    </div>
</div>

<% if (erros.all.length) { %>
    <div class="alert alert-danger">
        <h5>Não foi possível salvar</h5>
        <ul>
            <% erros.all.forEach(msg => { %><li><%= msg %></li><% }) %>
        </ul>
    </div>
<% } %>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <form action="/propriedades/<%= propriedade.id ? propriedade.id + '/editar' : 'criar' %>" method="POST">
                    <div class="form-row">
                        <div class="form-group col-md-8 mb-3">
                            <label for="nome">Nome da Propriedade</label>
                            <input type="text"
                                class="form-control <%= erros.has('nome') ? 'is-invalid' : '' %>"
                                id="nome" name="nome"
                                placeholder="Ex: Fazenda São João"
                                value="<%= propriedade.nome || '' %>">
                            <% if (erros.has('nome')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('nome').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                        <div class="form-group col-md-4 mb-3">
                            <label for="tamanho">Tamanho (alqueires)</label>
                            <input type="number" step="0.01"
                                class="form-control <%= erros.has('tamanho') ? 'is-invalid' : '' %>"
                                id="tamanho" name="tamanho"
                                placeholder="Ex: 45"
                                value="<%= propriedade.tamanho || '' %>">
                            <% if (erros.has('tamanho')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('tamanho').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4 mb-3">
                            <label for="linha">Nº da Linha</label>
                            <input type="text"
                                class="form-control <%= erros.has('linha') ? 'is-invalid' : '' %>"
                                id="linha" name="linha"
                                placeholder="Ex: Linha 12"
                                value="<%= propriedade.linha || '' %>">
                            <% if (erros.has('linha')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('linha').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                        <div class="form-group col-md-5 mb-3">
                            <label for="cidade">Cidade</label>
                            <input type="text"
                                class="form-control <%= erros.has('cidade') ? 'is-invalid' : '' %>"
                                id="cidade" name="cidade"
                                placeholder="Ex: Ji-Paraná"
                                value="<%= propriedade.cidade || '' %>">
                            <% if (erros.has('cidade')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('cidade').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                        <div class="form-group col-md-3 mb-3">
                            <label for="estado">Estado</label>
                            <select name="estado"
                                class="form-control <%= erros.has('estado') ? 'is-invalid' : '' %>"
                                id="estado">
                                <option value="">Selecione...</option>
                                <option value="RO" <%= propriedade.estado === 'RO' ? 'selected' : '' %>>Rondônia</option>
                                <option value="AM" <%= propriedade.estado === 'AM' ? 'selected' : '' %>>Amazonas</option>
                                <option value="MT" <%= propriedade.estado === 'MT' ? 'selected' : '' %>>Mato Grosso</option>
                                <option value="PA" <%= propriedade.estado === 'PA' ? 'selected' : '' %>>Pará</option>
                                <option value="AC" <%= propriedade.estado === 'AC' ? 'selected' : '' %>>Acre</option>
                            </select>
                            <% if (erros.has('estado')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('estado').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary mr-2">
                            <i class="fa fa-save mr-1"></i> Salvar
                        </button>
                        <a href="/propriedades" class="btn btn-warning">
                            <i class="fa fa-times mr-1"></i> Cancelar
                        </a>
                        <a href="/" class="btn btn-secondary ml-2">
                            <i class="fa fa-home mr-1"></i> Menu Inicial
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>