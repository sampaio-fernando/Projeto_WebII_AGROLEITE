
<% animal = locals.animal || {} %>
<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>
                <%= locals.titulo %>
            </h4>
            <p class="mb-0">&raquo; <%= locals.subtitulo %></p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicial</a></li>
            <li class="breadcrumb-item"><a href="/animais">Consulta de Animais</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Excluir Animal</a></li>
        </ol>
    </div>
</div>
<!-- row -->
<div class="row">
    <div class="col-lg-8 offset-lg-2">
        <div class="card border-danger">
            <div class="card-header bg-danger p-3">
                <h4 class="card-title text-white mb-0">Exclusão de animal</h4>
            </div>

            <div class="card-body">
                <div class="alert alert-warning">
                    <b>Está ação excluirá o registro de forma permanente.</b>
                </div>

                <p class="mb-4">
                    Tem certeza que deseja excluir o animais abaixo?
                </p>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered mb-0">
                        <tbody>
                            <tr>
                                <th>Identificação</th>
                                <td><%= animal.identificacao %></td>
                            </tr>
                            <tr>
                                <th>Data de Nascimento</th>
                                <td><%= animal.data_nascimento %></td>
                            </tr>
                            <tr>
                                <th>Peso</th>
                                <td><%= animal.peso %></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <form action="/animais/<%= animal.id %>/excluir" method="post">
                    <button type="submit" class="btn btn-danger mr-2">Confirmar Exclusão</button>
                    <a href="/animais" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>