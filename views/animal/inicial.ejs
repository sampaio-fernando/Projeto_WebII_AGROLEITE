<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>
                <%= titulo %>
            </h4>
            <p class="mb-0">&raquo; Consulte todos os animais do sistema</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicial</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Animais</a></li>
        </ol>
    </div>
</div>
<!-- row -->

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                
                <div class="basic-form flex-grow-1">
                    <form>
                        <div class="form-row">
                            <div class="col-lg-10">
                                <input type="text" class="form-control" placeholder="Digite para pesquisar...">
                            </div>
                            <div class="col-lg-2 mt-2 mt-lg-0">
                                <button type="submit" class="btn btn-warning mb-2">Pesquisar</button>
                            </div>
                        </div>
                    </form>
                </div>

                <a href="/animais/criar" class="btn btn-primary mb-2">Adicionar Novo Animal</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Identificação</th>
                                <th>Data Nascimento</th>
                                <th>Peso (Kg)</th>
                                <th>Categoria</th>
                                <th>Propriedade</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>

                            <% for( let index = 0; index < animais.length; index++ ) { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= animais[index].identificacao %></td>
                                    <td><%= dateFormat(animais[index].data_nascimento) %></td>
                                    <td><%= animais[index].peso %></td>
                                    <td><%= animais[index]?.categoria?.nome ? animais[index]?.categoria?.nome : '-' %></td>
                                    <td><%= animais[index]?.propriedade?.nome ? animais[index]?.propriedade?.nome : '-' %></td>
                                    <td>
                                        <a href="/animais/<%= animais[index].id %>/editar" class="text-warning mr-1">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </a>
                                        <a href="/animais/<%= animais[index].id %>/excluir" class="text-danger">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>