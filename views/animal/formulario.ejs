<% const erros = validationErrors(locals.errors); %>
<% const animal = locals.animal || {} %>
<% const categorias = locals.categorias || [] %>
<% const propriedades = locals.propriedades || [] %>


<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>
                <%= locals.titulo %>
            </h4>
            <p class="mb-0">&raquo; Adicionar novo animal</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicial</a></li>
            <li class="breadcrumb-item"><a href="/animais">Consulta de Animais</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Novo Animal</a></li>
        </ol>
    </div>
</div>
<!-- row -->
<div class="row">
    <div class="col-lg-12">

        <% if (erros.all.length) { %>
            <div class="alert alert-danger">
              <h5>Não foi possível salvar</h5>
              <ul>
                <% erros.all.forEach((mensagem) => { %>
                  <li><%= mensagem %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>

        <div class="card">
            <div class="card-body">
                <form action="/animais/<%= animal.id ? animal.id + '/editar' : 'criar' %>" method="POST">
                    <div class="form-group mb-3">
                        <label for="nome" class="form-label">Identificação:</label>
                        <input type="text" class="form-control <%= erros.has('identificacao') ? 'is-invalid' : '' %>" 
                            id="identificacao" name="identificacao" placeholder="Informe a identificação do animal" value="<%= animal ? animal.identificacao : '' %>">

                            <% if (erros.has('identificacao')) { %>
                                <div class="invalid-feedback d-block">
                                    <ul>
                                        <% erros.get('identificacao').forEach((mensagem) => { %>
                                            <li> <%= mensagem %> </li>
                                        <% }) %>
                                    </ul>   
                                </div>
                            <% } %>
                    </div>

                    <div class="form-group col-md-4 mb-3">
                            <label for="data_nascimento">Data de Nascimento</label>
                            <input type="date"
                                class="form-control <%= erros.has('data_nascimento') ? 'is-invalid' : '' %>"
                                id="data_nascimento" name="data_nascimento"
                                value="<%= animal.data_nascimento || '' %>">
                            <% if (erros.has('data_nascimento')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('data_nascimento).forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label for="peso" class="form-label">Peso:</label>
                            <input type="number" class="form-control" id="peso" name="peso" 
                                placeholder="0" min="0" value="<%= animal ? animal.peso : '' %>">
                        </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-3">

                            <label for="categoria" class="form-label">Categoria</label>
                            <select name="categoria" class="form-control">
                                <option value="">Selecione a categoria:</option>

                                <% categorias.forEach(categoria => { %>
                                    <option value="<%= categoria.id %>" <%= categoria.id == animal?.categoria?.id ? 'selected' : '' %> ><%= categoria.nome %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group col-md-6 mb-3">

                            <label for="propriedade" class="form-label">Propriedade</label>
                            <select name="propriedade" class="form-control">
                                <option value="">Selecione a propriedade:</option>

                                <% propriedades.forEach(propriedade => { %>
                                    <option value="<%= propriedade.id %>" <%= propriedade.id == animal?.propriedade?.id ? 'selected' : '' %> ><%= propriedade.nome %></option>
                                <% }) %>
                            </select>
                        </div>

                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary mr-2">Salvar Produto</button>
                        <a href="/produtos" class="btn btn-warning">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>