<% const erros = validationErrors(locals.errors); %>
<% const piquete = locals.piquete || {}; %>
<% const propriedades = locals.propriedades || []; %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4><%= titulo %></h4>
            <p class="mb-0">&raquo; Preencha os dados do piquete</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicial</a></li>
            <li class="breadcrumb-item"><a href="/piquetes">Piquetes</a></li>
            <li class="breadcrumb-item active">Formulário</li>
        </ol>
    </div>
</div>

<% if (erros.all.length) { %>
    <div class="alert alert-danger">
        <h5>Não foi possível salvar</h5>
        <ul>
            <% erros.all.forEach(msg => { %><li><%= msg %></li><% }) %>
        </ul>
    </div>
<% } %>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <form action="/piquetes/<%= piquete.id ? piquete.id + '/editar' : 'criar' %>" method="POST">
                    <div class="form-row">
                        <div class="form-group col-md-5 mb-3">
                            <label for="nome">Nome do Piquete</label>
                            <input type="text"
                                class="form-control <%= erros.has('nome') ? 'is-invalid' : '' %>"
                                id="nome" name="nome"
                                placeholder="Ex: Piquete A1"
                                value="<%= piquete.nome || '' %>">
                            <% if (erros.has('nome')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('nome').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                        <div class="form-group col-md-3 mb-3">
                            <label for="tamanho">Tamanho (alqueires)</label>
                            <input type="number" step="0.01"
                                class="form-control <%= erros.has('tamanho') ? 'is-invalid' : '' %>"
                                id="tamanho" name="tamanho"
                                placeholder="Ex: 3.5"
                                value="<%= piquete.tamanho || '' %>">
                            <% if (erros.has('tamanho')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('tamanho').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                        <div class="form-group col-md-4 mb-3">
                            <label for="tipoPastagem">Tipo de Pastagem</label>
                            <input type="text"
                                class="form-control <%= erros.has('tipoPastagem') ? 'is-invalid' : '' %>"
                                id="tipoPastagem" name="tipoPastagem"
                                placeholder="Ex: Brachiaria brizantha"
                                value="<%= piquete.tipoPastagem || '' %>">
                            <% if (erros.has('tipoPastagem')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('tipoPastagem').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6 mb-3">
                            <label for="propriedade">Propriedade</label>
                            <select name="propriedade"
                                class="form-control <%= erros.has('propriedade') ? 'is-invalid' : '' %>"
                                id="propriedade">
                                <option value="">Selecione uma propriedade...</option>
                                <% propriedades.forEach(p => { %>
                                    <option value="<%= p.id %>"
                                        <%= p.id == (piquete.propriedade?.id || piquete.propriedade) ? 'selected' : '' %>>
                                        <%= p.nome %>
                                    </option>
                                <% }) %>
                            </select>
                            <% if (erros.has('propriedade')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('propriedade').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary mr-2">
                            <i class="fa fa-save mr-1"></i> Salvar
                        </button>
                        <a href="/piquetes" class="btn btn-warning">
                            <i class="fa fa-times mr-1"></i> Cancelar
                        </a>
                        <a href="/" class="btn btn-secondary ml-2">
                            <i class="fa fa-home mr-1"></i> Menu Inicial
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>