<% producaoMensal = locals.producaoMensal || {} %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4><%= locals.titulo %></h4>
            <p class="mb-0">&raquo; <%= locals.subtitulo %></p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicial</a></li>
            <li class="breadcrumb-item"><a href="/producoes-mensais">Consulta de Produção Mensal</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Excluir Produção Mensal</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 offset-lg-2">
        <div class="card border-danger">
            <div class="card-header bg-danger p-3">
                <h4 class="card-title text-white mb-0">Exclusão de produção mensal</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <b>Esta ação excluirá o registro de forma permanente.</b>
                </div>
                <p class="mb-4">
                    Tem certeza que deseja excluir a produção mensal abaixo?
                </p>
                <div class="table-responsive mb-4">
                    <table class="table table-bordered mb-0">
                        <tbody>
                            <tr>
                                <th>Mês de Referência</th>
                                <td><%= producaoMensal.mesReferencia %></td>
                            </tr>
                            <tr>
                                <th>Quantidade Total</th>
                                <td><%= producaoMensal.qtdTotalLitros %> L</td>
                            </tr>
                            <tr>
                                <th>Valor por Litro</th>
                                <td><%= moneyFormat(producaoMensal.valorLitro) %></td>
                            </tr>
                            <tr>
                                <th>Valor Total</th>
                                <td><%= moneyFormat(producaoMensal.valorTotal) %></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <form action="/producoes-mensais/<%= producaoMensal.id %>/excluir" method="POST">
                    <button type="submit" class="btn btn-danger mr-2">Confirmar Exclusão</button>
                    <a href="/producoes-mensais" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>