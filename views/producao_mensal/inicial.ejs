<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4><%= locals.titulo %></h4>
            <p class="mb-0">&raquo; Consulte todas as produções mensais</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicial</a></li>
            <li class="breadcrumb-item active">Produção Mensal</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="basic-form flex-grow-1">
                    <form>
                        <div class="form-row">
                            <div class="col-lg-10">
                                <input type="text" class="form-control" placeholder="Digite para pesquisar...">
                            </div>
                            <div class="col-lg-2 mt-2 mt-lg-0">
                                <button type="submit" class="btn btn-warning mb-2">Pesquisar</button>
                            </div>
                        </div>
                    </form>
                </div>
                <a href="/producoes-mensais/criar" class="btn btn-primary mb-2">Adicionar Produção Mensal</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Mês Referência</th>
                                <th>Total (litros)</th>
                                <th>Valor/Litro</th>
                                <th>Valor Total</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let index = 0; index < producoesMensais.length; index++) { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= producoesMensais[index].mesReferencia %></td>
                                    <td><%= producoesMensais[index].qtdTotalLitros %> L</td>
                                    <td><%= moneyFormat(producoesMensais[index].valorLitro) %></td>
                                    <td><%= moneyFormat(producoesMensais[index].valorTotal) %></td>
                                    <td>
                                        <a href="/producoes-mensais/<%= producoesMensais[index].id %>/editar" class="text-warning mr-1">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </a>
                                        <a href="/producoes-mensais/<%= producoesMensais[index].id %>/excluir" class="text-danger">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>