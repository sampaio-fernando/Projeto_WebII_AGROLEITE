<% const erros = validationErrors(locals.errors); %>
<% const categoria = locals.categoria || {}; %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4><%= titulo %></h4>
            <p class="mb-0">&raquo; Preencha os dados da categoria</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicial</a></li>
            <li class="breadcrumb-item"><a href="/categoria">Categorias</a></li>
            <li class="breadcrumb-item active">Formulário</li>
        </ol>
    </div>
</div>

<% if (erros.all.length) { %>
    <div class="alert alert-danger">
        <h5>Não foi possível salvar</h5>
        <ul>
            <% erros.all.forEach(msg => { %><li><%= msg %></li><% }) %>
        </ul>
    </div>
<% } %>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <form action="/categoria/<%= categoria.id ? categoria.id + '/editar' : 'criar' %>" method="POST">
                    <div class="form-row">
                        
                        <div class="form-group col-md-9 mb-3">
                            <label for="nome">Nome da Categoria</label>
                            <input type="text"
                                class="form-control <%= erros.has('nome') ? 'is-invalid' : '' %>"
                                id="nome" name="nome"
                                placeholder="Ex: Vaca"
                                value="<%= categoria.nome || '' %>">
                            <% if (erros.has('nome')) { %>
                                <div class="invalid-feedback d-block">
                                    <% erros.get('nome').forEach(m => { %><span><%= m %></span><br><% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary mr-2">
                            <i class="fa fa-save mr-1"></i> Salvar
                        </button>
                        <a href="/categoria" class="btn btn-warning">
                            <i class="fa fa-times mr-1"></i> Cancelar
                        </a>
                        <a href="/" class="btn btn-secondary ml-2">
                            <i class="fa fa-home mr-1"></i> Menu Inicial
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>